# ── Required ─────────────────────────────────────────────────────────────────
# Azure Log Analytics workspace GUID
# Find in: Azure Portal → Log Analytics workspace → Overview → Workspace ID
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-workspace-guid-here

# ── Authentication ────────────────────────────────────────────────────────────
# For LOCAL DEVELOPMENT: run 'az login' first — DefaultAzureCredential picks it up.
# For AZURE DEPLOYMENT:  Assign the Managed Identity 'Log Analytics Reader' role;
#                        leave CLIENT_ID and CLIENT_SECRET blank.

# Entra tenant ID (required for local dev and service principal auth)
AZURE_TENANT_ID=your-tenant-id-here

# Service principal credentials (optional — leave blank to use az login or Managed Identity)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── SID-to-Workspace Mapping ──────────────────────────────────────────────────
# Map specific SIDs to different Log Analytics workspaces.
# Format: SID_WORKSPACE_MAP=SID1:workspace-guid-1,SID2:workspace-guid-2
# If a SID is not in the map, AZURE_LOG_ANALYTICS_WORKSPACE_ID is used as fallback.
SID_WORKSPACE_MAP=

# ── Optional ──────────────────────────────────────────────────────────────────
# Default SAP SID when not provided in a tool call
DEFAULT_SID=

# Maximum rows returned by any single query
MAX_QUERY_ROWS=1000

# Log Analytics query timeout in seconds
QUERY_TIMEOUT_SECONDS=60
