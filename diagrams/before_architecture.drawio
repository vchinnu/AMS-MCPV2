        <!-- Problems box -->
        <mxCell id="problems" value="&lt;b&gt;❌ Problems&lt;/b&gt;&lt;br&gt;• Raw rows sent to model = high token consumption&lt;br&gt;• Classification is a separate call = extra round-trip&lt;br&gt;• No caching = repeat queries re-execute against LA&lt;br&gt;• Monolithic analyzer = hard to extend (3 files to edit)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
